<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="laundry_treatment_view_list" model="ir.ui.view">
        <field name="name">laundry.treatment.list</field>
        <field name="model">laundry.treatment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="print_on_tag"/>
            </list>
        </field>
    </record>

    <record id="laundry_treatment_action" model="ir.actions.act_window">
        <field name="name">Traitements</field>
        <field name="res_model">laundry.treatment</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="laundry_treatment_menu"
              name="Traitements"
              parent="point_of_sale.menu_point_config_product"
              action="laundry_treatment_action"
              sequence="90"/>
</odoo>
